local choose = require("../RobloxUILibrary/KaitunPlanner")
local function check(expected, snapshot, config)
    local actual = choose(snapshot, config)
    assert(actual == expected, "expected " .. expected .. ", got " .. tostring(actual))
end
local function sample(level, sea, saber, alive)
    return {Supported=true, Level=level, Sea=sea or 1, Saber=saber, Alive=alive ~= false}
end
check("stop", {Supported=false}, {Target=700})
check("wait", sample(nil), {Target=700})
check("wait", sample(300, 1, false, false), {Target=700, Saber=true})
check("wait", sample(300), {Target=700, Saber=true})
check("level", sample(100, 1, false), {Target=700, Saber=true})
check("saber", sample(200, 1, false), {Target=700, Saber=true})
check("level", sample(200, 1, true), {Target=700, Saber=true})
check("saber", sample(700, 1, false), {Target=700, Saber=true, SecondSea=true})
check("sea2", sample(700, 1, true), {Target=700, Saber=true, SecondSea=true})
check("done", sample(700, 2), {Target=700, Saber=true, SecondSea=true})
check("done", sample(200, 1, true), {Target=100, Saber=true})
check("level", sample(100, 1, true), {Target=100, SecondSea=true})
check("done", sample(700, 1), {Target=700})
check("level", sample(800, 2), {Target=1000, Saber=true})
check("level", sample(1500, 3), {Target=2000, SecondSea=true})
check("wait", sample(0/0), {Target=700})
check("level", sample(100), {Target=700, Saber=true})
print("17 Kaitun policy scenarios passed")
